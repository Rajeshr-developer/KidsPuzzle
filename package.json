{
  "name": "kidspuzzle",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "node --openssl-legacy-provider ./node_modules/react-native/cli.js start",
    "web": "webpack serve --config webpack.config.js --mode development --hot --port 8080",
    "web:build": "webpack --config webpack.config.js --mode production",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "debug-build": "cd android && gradlew assembleDebug",
    "build": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res"
  },
  "dependencies": {
    "@types/styled-components-react-native": "^5.1.3",
    "react": "17.0.2",
    "react-dom": "^17.0.2",
    "react-native": "0.67.2",
    "react-native-draggable": "^3.3.0",
    "react-native-sound": "^0.11.2",
    "react-native-web": "0.18.12",
    "styled-components": "^5.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.12.9",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@babel/runtime": "^7.12.5",
    "@react-native-community/eslint-config": "^2.0.0",
    "@types/jest": "^26.0.23",
    "@types/react-native": "^0.66.15",
    "@types/react-test-renderer": "^17.0.1",
    "@types/styled-components": "^5.1.22",
    "@typescript-eslint/eslint-plugin": "^5.7.0",
    "@typescript-eslint/parser": "^5.7.0",
    "ajv": "^8.17.1",
    "babel-jest": "^26.6.3",
    "babel-loader": "^10.0.0",
    "eslint": "^7.14.0",
    "html-webpack-plugin": "^5.6.4",
    "jest": "^26.6.3",
    "metro-react-native-babel-preset": "^0.66.2",
    "react-test-renderer": "17.0.2",
    "typescript": "^4.4.4",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "resolutions": {
    "@types/react": "^17"
  },
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  }
}
